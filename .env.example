# ---------- 数据库（Neon Postgres + pgvector） ----------
# 运行时使用 pooled 连接（应用查询）
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# 迁移使用直连（drizzle-kit migrate 需要）
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# ---------- AI Provider（OpenAI 或 OpenAI 兼容网关） ----------
AI_API_KEY=your-openai-api-key
# 可留空走代码内默认网关；建议显式设置为官方或自建网关地址
AI_BASE_URL=https://api.openai.com/v1
# 模型必须对当前 AI_BASE_URL 网关可用。默认值针对示例网关实测可选；
# 换成 OpenAI 官方时请改为 gpt-4o-mini / text-embedding-3-small。
# ⚠️ 改 embedding 模型必须同步修改 src/lib/ai-config.ts 的 EMBEDDING_DIMENSIONS 并重新迁移。
AI_CHAT_MODEL=gpt-5.5
AI_EMBEDDING_MODEL=nemotron-3-embed-1b

# ---------- Neon CLI（可选，本地分支管理用） ----------
# NEON_API_KEY=
